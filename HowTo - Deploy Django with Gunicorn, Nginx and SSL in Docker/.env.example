# Optional: copy this file to '.env' to override the defaults:  cp .env.example .env
# Without '.env' the app starts with the values shown here.
# '.env' may contain secrets - it is ignored by git and must never be committed.

# --- Django ---
# Leave empty to use the random key that is created on the first start
# (stored in the volume 'sqlite_data'). To set your own key, generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (Avoid '$' in values - Docker Compose would try to interpolate it.)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Keep 'localhost' in the list - the health check of the 'web' container uses it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
# HSTS makes browsers refuse plain HTTP for the host - only set it (e.g. 31536000)
# when you use a certificate from a trusted CA.
DJANGO_SECURE_HSTS_SECONDS=0

# --- Gunicorn ---
GUNICORN_WORKERS=3
